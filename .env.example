# PostgreSQL local
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/restaurante_sistema?schema=public"
# Secreto para firmar la cookie de sesión (jose). Genera uno: openssl rand -base64 32
SESSION_SECRET="cambia-esto"
# BD separada para los tests de integración (npm test la migra sola; nunca la de desarrollo)
TEST_DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/restaurante_sistema_test"
# URL pública que codifican los QR de las mesas (sin barra final). Si falta, se usa el origen del request.
PUBLIC_BASE_URL="http://localhost:3000"
# BD separada para las pruebas E2E (npm run test:e2e la resetea y siembra en cada ejecución; nunca la de desarrollo)
E2E_DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/restaurante_sistema_e2e"
